# Copy this file to .env. Keep all credentials on the server.
ADMIN_EMAIL=admin@yourcollege.edu.in
ADMIN_PASSWORD=YourSecureAdminPassword123!
COLLEGE_EMAIL_DOMAINS=yourcollege.edu.in,students.yourcollege.edu.in,gmail.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusconnect?retryWrites=true&w=majority

# Session Secret (random long string)
SESSION_SECRET=your_random_session_secret_key_here

# Browser origin. For local Vite development use this exact localhost address.
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3001

# Set true before first startup to seed sample opportunities and mock users
SEED_SAMPLE_DATA=true

# Real email OTP delivery (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Gemini AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
COLLEGE_FAQ=Contact the placement cell for college-specific rules and schedules.
